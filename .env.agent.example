# Agent: NO payment secrets. The agent only talks to the firewall and the sellers; it never holds a wallet key.
FIREWALL_URL=http://localhost:4000
SELLERS_URL=http://localhost:4200
# Which agent this is, and its own firewall key (from the dashboard's Add agent, or FIREWALL_AGENT_TOKENS on the firewall).
AGENT_ID=research-agent
FIREWALL_AGENT_TOKEN=
# The LLM agent's model key (apps/agent/src/llm.ts). It's allowed in the agent's environment because it can't move money.
ANTHROPIC_API_KEY=
