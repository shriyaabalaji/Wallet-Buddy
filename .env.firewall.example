# Firewall service ONLY. Holds every secret (buyer key, service/treasury key, owner key, Twilio, LLM).
# Never give this file to the agent process. Copy to .env.firewall and chmod 600.
# Never commit real values. Copy to .env.
CIRCLE_API_KEY=
# Arc testnet values verified in docs/RESEARCH.md
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
SERVICE_PRIVATE_KEY=
OWNER_ADDRESS=
VAULT_ADDRESS=
REGISTRY_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
TREASURY_PRIVATE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
# Rules compiler + demo agent (Anthropic API)
LLM_API_KEY=
APP_BASE_URL=http://localhost:3000
FIREWALL_URL=http://localhost:4000
FIREWALL_PORT=4000
FIREWALL_DB=./firewall.db

# --- Firewall API credentials (each >= 32 chars; generate with: openssl rand -base64 32) ---
# Owner: rules, pause/resume, activity, passkey enrollment. Give the SAME value to the dashboard server
# (apps/web/.env.local), never to a browser or an agent. Unset = owner routes return 503.
FIREWALL_OWNER_TOKEN=
# One token per agent, bound to that agent id. Each agent gets only its own, as FIREWALL_AGENT_TOKEN.
FIREWALL_AGENT_TOKENS=research-agent=,race-agent=
# Optional: a trusted payment service that may report /settled and /failed.
FIREWALL_SERVICE_TOKEN=
# Testnet migration only, until the agent sends FIREWALL_AGENT_TOKEN: 1 = agent routes accept no token.
# Never opens owner routes; refused in production and on mainnet.
FIREWALL_ALLOW_UNAUTHENTICATED_AGENTS=0

# --- Anomaly detection (optional overrides of ANOMALY_DEFAULTS in apps/firewall/src/anomaly.ts; positive integers) ---
# e.g. ANOMALY_AMOUNT_ABSOLUTE_MICRO=2000000  ANOMALY_FREQUENCY_MIN_COUNT=10  ANOMALY_DENIAL_COUNT=3

# Allowed payments never signed or paid give their budget back after this many minutes (>= 5). Signed or uncertain
# payments are never released by time; the owner reconciles them.
RESERVATION_TTL_MINUTES=15

# --- How the firewall pays ---
# Default: a Circle Agent Wallet via the Circle CLI session of the user running the firewall (circle wallet login).
# PAYMENT_MODE=local-key falls back to signing with BUYER_PRIVATE_KEY (testnet only).
# NETWORK=mainnet (shell only, never in this file) switches to Arc mainnet using .env.firewall.mainnet.
PAYMENT_MODE=
# The wallet's Gateway balance is held by its backing EOA: circle gateway balance --address <W> --chain ARC-TESTNET --output json → backingEOA
CIRCLE_GATEWAY_DEPOSITOR=
CIRCLE_AGENT_WALLET_ADDRESS=

# --- Firewall-held keys (the agent never sees these) ---
# Buyer wallet: firewall signs x402 Gateway authorizations with it, only for allowed payments.
BUYER_PRIVATE_KEY=
# Hackathon shortcut: owner key used for ApprovalVault.approve() ONLY after a verified passkey.
OWNER_PRIVATE_KEY=
TREASURY_ADDRESS=
# Recipient ids → addresses, used to bind allowlisted service ids to payTo addresses
# Optional: sellers to register on first start (name=wallet). Manage them afterwards in Settings → Sellers.
SELLER_ADDRESSES=sportsfeed=0x...,oddsapi=0x...
GATEWAY_WALLET_ADDRESSES=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# --- Misc ---
FIREWALL_PUBLIC_URL=http://localhost:4000   # must match Twilio's webhook URL exactly (signature check)
WEBAUTHN_RP_ID=localhost
HOLD_MINUTES=15
SELLERS_PORT=4200
SELLERS_URL=http://localhost:4200
# 1 = sellers accept any payment header (local demo without testnet funds)
MOCK_PAYMENTS=0
# The dashboard reads its own settings from apps/web/.env.local (see apps/web/.env.example).

# --- Texts via Textbelt (real SMS to US numbers, no carrier registration). Takes priority over Twilio when set. ---
# Buy a key at textbelt.com (replies need a paid key). Replies reach FIREWALL_PUBLIC_URL/v1/sms/textbelt, so set
# FIREWALL_PUBLIC_URL to a public https URL (e.g. a cloudflared tunnel to :4000).
TEXTBELT_KEY=
# 1 once textbelt.com/whitelist has approved links for your key (then texts also carry the approve link).
TEXTBELT_URLS=0

# --- Optional tuning ---
# Testnet: max USDC the firewall deposits into the payer's Gateway balance per UTC day (the worst-case-loss bound).
# GATEWAY_DAILY_TOPUP_USDC=5
# local-key mode: USDC left in the buyer wallet for gas; the rest is swept to the treasury.
# BUYER_GAS_RESERVE_USDC=0.5
# Circle CLI binary and chain (defaults: circle, ARC-TESTNET / ARC on mainnet) and the CAIP-2 network sellers must offer.
# CIRCLE_CLI_BIN=circle
# CIRCLE_CHAIN=ARC-TESTNET
# PAY_NETWORK=eip155:5042002
# Onchain proof indexer starts at the contracts' deploy block (Deploy.s.sol broadcast).
# PROOF_FROM_BLOCK=72618073
# Optimizer: how long a seller's live 402 quote is trusted.
# OPTIMIZER_QUOTE_TTL_MS=60000
# Mainnet is opt-in ONLY via the shell: NETWORK=mainnet (never read from this file). See README.
