# Server-side only (no NEXT_PUBLIC_ prefix: none of these ever reach the browser). Copy to apps/web/.env.local.
# Where the dashboard's server-side proxy finds the firewall.
FIREWALL_URL=http://localhost:4000
# Same value as FIREWALL_OWNER_TOKEN in .env.firewall.
FIREWALL_OWNER_TOKEN=
# Owner sign-in for the dashboard (>= 12 chars) and the cookie-signing secret (>= 32 chars, openssl rand -base64 32).
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Optional: pin the dashboard's public origin for the CSRF check (set this behind an HTTPS tunnel).
DASHBOARD_ORIGIN=
